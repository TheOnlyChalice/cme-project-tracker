# Copy this file to .env (same folder) and fill in your password.
# .env is ignored by Git, so your password never reaches GitHub.

# Use PostgreSQL. Remove this line (or set it to memory) to run without a database.
STORE_BACKEND=postgres

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=your-postgres-password
POSTGRES_NAME=cme

# Optional: the starter users' password (used once login arrives).
# DEV_SEED_PASSWORD=ChangeMe123
